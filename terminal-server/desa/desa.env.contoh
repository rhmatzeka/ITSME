# Salin ke /etc/mapporto/desa.env (chmod 600, pemilik root). Jangan di-commit.
# pasang.sh membuatnya sendiri dengan dua kunci acak kalau belum ada.
#
# Tanda tangan tautan hapus di kabar Telegram buku tamu.
DESA_RAHASIA=
# Kunci yang dipakai /admin (lewat API Vercel) untuk menghapus pesan buku tamu.
# Isi yang SAMA di Vercel: Environment Variable DESA_ADMIN_KEY (Production + Preview).
DESA_ADMIN_KEY=
# opsional:
# PUBLIK=https://terminal.rahmateka.my.id
# ASAL_TAMBAHAN=http://127.0.0.1:4399
