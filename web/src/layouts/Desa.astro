---
import { getCollection } from 'astro:content';
import { RUTE } from '../rute';
import { aset } from '../game/aset';
import '../styles/global.css';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const pages = await getCollection('pages');

interface Props {
  judul: string;
  deskripsi: string;
  /** Alamat kanonik halaman ini, untuk <link rel="canonical">. */
  alamat: string;
}
const { judul, deskripsi, alamat } = Astro.props;
const SITUS = 'https://www.rahmateka.my.id';
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{judul}</title>
    <meta name="description" content={deskripsi} />
    <link rel="canonical" href={SITUS + alamat} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={judul} />
    <meta property="og:description" content={deskripsi} />
    <meta property="og:url" content={SITUS + alamat} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=Pixelify+Sans:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <!-- Canvas game -->
    <div id="game" aria-hidden="true"></div>

    <!-- Menu atas -->
    <nav class="topbar">
      <a class="brand" href="/">RAHMAT<br /><span>PORTOFOLIO</span></a>
      <ul>
        {RUTE.map((r) => (
          <li><a class="pixbtn" href={`/${r.ruas}`} data-travel={r.poi}>{r.label}</a></li>
        ))}
      </ul>
      <div class="tools">
        <button class="pixbtn desk-only" data-open-map>MAP</button>
        <!-- Ikon, bukan tulisan: deretan ini sudah padat, dan tiap kata memajukan
             titik di mana bilahnya pecah jadi dua baris. Satu gir menggantikan
             dua tombol terpisah (FX dan pengeras suara) — keduanya pindah ke
             dalam, bersama pengatur volume yang tidak akan pernah muat di sini. -->
        <button class="pixbtn ikon desk-only" data-open-setelan title="Setelan" aria-label="Setelan">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <g fill="currentColor">
              <rect x="6.4" y="0" width="3.2" height="16" />
              <rect x="0" y="6.4" width="16" height="3.2" />
              <rect x="6.4" y="0" width="3.2" height="16" transform="rotate(45 8 8)" />
              <rect x="0" y="6.4" width="16" height="3.2" transform="rotate(45 8 8)" />
              <circle cx="8" cy="8" r="5.4" />
            </g>
            <circle cx="8" cy="8" r="2.2" fill="var(--warna-tombol, #fff)" />
          </svg>
        </button>
        <button class="pixbtn phone-only" data-open-menu>MENU</button>
      </div>
    </nav>

    <!-- Menu layar kecil: semua tujuan dalam satu daftar -->
    <div class="modal" id="menusheet" hidden>
      <div class="menulist">
        <header>
          <h2>MENU</h2>
          <button class="pixbtn close" data-close-menu aria-label="Tutup">✕</button>
        </header>
        <ul>
          {RUTE.map((r) => (
            <li><a class="pixbtn wide" href={`/${r.ruas}`} data-travel={r.poi}>{r.label}</a></li>
          ))}
          <li><button class="pixbtn wide" data-open-map>Peta Desa</button></li>
          <li><button class="pixbtn wide" data-open-setelan>Setelan</button></li>
        </ul>
      </div>
    </div>

    <!-- Setelan: dua hal yang dulu jadi dua tombol terpisah di bilah atas,
         plus pengatur volume yang memang butuh ruang -->
    <div class="modal" id="setelan" hidden>
      <div class="menulist">
        <header>
          <h2>SETELAN</h2>
          <button class="pixbtn close" data-close-setelan aria-label="Tutup">✕</button>
        </header>

        <section class="setel">
          <h3>Suara</h3>
          <div class="barissuara">
            <button class="pixbtn ikon" data-toggle-sound aria-label="Bisukan">
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M3 6h2l3-3v10L5 10H3z" fill="currentColor" />
                <path class="gelombang" d="M10.5 5.5a3.6 3.6 0 0 1 0 5M12.8 3.4a6.4 6.4 0 0 1 0 9.2" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path class="coret" d="M10.6 5.6l4.4 4.8M15 5.6l-4.4 4.8" stroke="currentColor" stroke-width="1.6" />
              </svg>
            </button>
            <input type="range" id="volume" min="0" max="100" step="5" aria-label="Volume" />
            <output id="volume-nilai">100%</output>
          </div>
          <p class="katatambahan">Musik latar dan bunyi tombol. Mematikannya diingat untuk
            kunjungan berikutnya.</p>
        </section>

        <section class="setel">
          <h3>Animasi petir</h3>
          <button class="pixbtn wide" data-toggle-fast>Animasi cepat</button>
          <p class="katatambahan">Perpendek jeda tiap kali berpindah tempat. Sesudah sepuluh
            perpindahan ini menyala sendiri.</p>
        </section>
      </div>
    </div>

    <!-- Panel konten: kartu di tengah layar, bukan laci di samping -->
    <div class="modal" id="panel" hidden>
      <article class="sheet">
        <div class="tutupwrap">
          <button class="pixbtn close" data-close-panel aria-label="Tutup">✕</button>
        </div>
        <h2 id="panel-title"></h2>
        <div class="prose" id="panel-body"></div>
      </article>
    </div>

    <!-- Peta besar: gambar map sungguhan, klik tujuan untuk pindah ke sana -->
    <div class="modal" id="mapmodal" hidden>
      <div class="mapsheet">
        <header>
          <h2>PETA DESA</h2>
          <button class="pixbtn" data-close-map aria-label="Tutup">✕</button>
        </header>
        <div class="mapwrap" id="mapwrap">
          <img src={aset("map_full.png")} alt="Peta Desa Mapporto" id="mapimg" />
          <!-- penanda diisi dari daftar POI milik game -->
        </div>
        <p class="maphint">Klik salah satu tempat untuk pindah ke sana.</p>
      </div>
    </div>

    <!-- Fallback statis: kebaca Google, dan kebaca orang yang tidak mau main game -->
    <noscript>
      <main class="fallback">
        <h1>Rahmat Portofolio</h1>
        {pages.map((p) => (
          <section>
            <h2>{p.data.title}</h2>
            <p>{p.body}</p>
            {p.data.groups?.map((g) => (
              <p><b>{g.title}</b>: {g.items.join(' · ')}</p>
            ))}
          </section>
        ))}
        <h2>Projects</h2>
        {projects.map((p) => (
          <article>
            <h3>{p.data.title}</h3>
            <p>{p.data.summary}</p>
          </article>
        ))}
      </main>
    </noscript>

    <script>
      import { startGame, travel } from '../game/main';
      import { efek, sedangBisu, setelBisu, setelVolume, volumeSekarang } from '../game/suara';
      import { RUTE, alamatPoi, poiAlamat } from '../rute';

      /*
       * Tautan lama berbentuk /#/rumah_cv masih beredar di luar sana. Ubah ke
       * alamat baru sebelum ada yang membacanya, supaya tidak ada tautan yang
       * mati hanya karena bentuk alamatnya berganti.
       */
      {
        const lawas = location.hash.match(/^#\/?(.+)$/);
        if (lawas) {
          const r = RUTE.find((x) => x.poi === lawas[1] || x.ruas === lawas[1]);
          history.replaceState(null, '', r ? `/${r.ruas}` : '/');
        }
      }

      const game = startGame('game');

      type Item = { slug: string; title: string; panel?: string; poi?: string; html?: string;
        summary?: string; stack?: string[]; image?: string; images?: string[]; year?: number; repo?: string; demo?: string;
        name?: string; role?: string; photo?: string;
        linkedin?: string; intro?: string; outro?: string;
        groups?: { title: string; items: string[] }[];
        links?: { icon: string; label: string; value: string; url: string }[] };
      let content: { projects: Item[]; pages: Item[] } | null = null;

      const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
      const panel = $('#panel');
      const panelTitle = $('#panel-title');
      const panelBody = $('#panel-body');
      const mapModal = $('#mapmodal');

      /* ---- panel ---- */
      /** Ikon digambar inline supaya tidak ada permintaan jaringan tambahan
          dan warnanya ikut tema. */
      const IKON: Record<string, string> = {
        mail: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 5h20v14H2z" fill="#fff" stroke="currentColor" stroke-width="2"/><path d="M3 6l9 7 9-7" fill="none" stroke="currentColor" stroke-width="2"/></svg>',
        whatsapp: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.7 15L2 22l5.2-1.3A10 10 0 1 0 12 2z" fill="#fff" stroke="currentColor" stroke-width="2"/><path d="M8.5 7.5c1 3.5 4.5 7 8 8l-1.5 1.5c-3.5-1-6.5-4-7.5-7.5z" fill="currentColor"/></svg>',
        linkedin: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" fill="#fff" stroke="currentColor" stroke-width="2"/><rect x="5" y="10" width="3" height="9" fill="currentColor"/><rect x="5" y="5" width="3" height="3" fill="currentColor"/><path d="M11 19v-9h3v1.5c.7-1 1.8-1.5 3-1.5 2 0 3 1.3 3 3.6V19h-3v-4.8c0-1.2-.4-1.9-1.5-1.9-1 0-1.5.7-1.5 1.9V19z" fill="currentColor"/></svg>',
        github: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-2c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .3.3.7 1 .7 2v3c0 .3.2.6.7.5A10 10 0 0 0 12 2z" fill="currentColor"/></svg>',
        doc: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 2h9l5 5v15H5z" fill="#fff" stroke="currentColor" stroke-width="2"/><path d="M14 2v5h5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 12h8M8 15h8M8 18h5" stroke="currentColor" stroke-width="2"/></svg>',
      };

      const tautanLuar = (url: string, teks: string) =>
        `<a class="pixbtn kecil" href="${url}" target="_blank" rel="noopener">${teks}</a>`;

      /**
       * Bingkai gambar sebuah kartu: satu gambar, beberapa gambar bergantian,
       * atau papan bergaris kalau memang belum ada gambarnya.
       */
      function bingkaiGambar(p: Item) {
        const daftar = p.images?.length ? p.images : p.image ? [p.image] : [];
        if (!daftar.length) return `<div class="shot kosong"><span>${p.title}</span></div>`;
        const gambar = daftar
          .map(
            (src, i) =>
              `<img src="${src}" alt="Cuplikan ${p.title} ${i + 1}"` +
              `${i === 0 ? ' class="tampil"' : ''} />`
          )
          .join('');
        if (daftar.length === 1) return `<div class="shot">${gambar}</div>`;
        const titik = daftar
          .map(
            (_, i) =>
              `<li><button type="button" data-ke="${i}" aria-current="${i === 0}"` +
              ` aria-label="Gambar ${i + 1}"></button></li>`
          )
          .join('');
        return `<div class="shot galeri" data-galeri>${gambar}<ul class="titik">${titik}</ul></div>`;
      }

      /*
       * Pemutar galeri.
       *
       * Timer-nya dicatat supaya bisa dimatikan: isi panel dibangun ulang tiap
       * kali dibuka, dan timer dari isi yang lama akan terus berdetak pada
       * elemen yang sudah tidak ada di halaman.
       */
      /**
       * Bentuk bingkai gambar mengikuti gambar sampulnya.
       *
       * Dibatasi antara 16:10 dan 3:4. Batas bawahnya bukan bentuk asli layar
       * ponsel (sekitar 9:19,5) dengan sengaja: bingkai setinggi itu di kolom
       * selebar 300px menghasilkan gambar 650px yang menenggelamkan seluruh
       * kartu. Pada 3:4 tangkapan layar ponsel menyisakan bilah di kiri-kanan
       * — terbaca seperti ponsel yang diletakkan di atas meja, dan tidak satu
       * piksel pun isinya hilang.
       */
      function bentukBingkai() {
        for (const kotak of document.querySelectorAll<HTMLElement>('.card .shot:not(.kosong)')) {
          const img = kotak.querySelector('img');
          if (!img) continue;
          const pas = () => {
            const r = img.naturalWidth / img.naturalHeight;
            if (r) kotak.style.aspectRatio = String(Math.min(1.6, Math.max(0.75, r)));
          };
          // gambar dari cache sudah selesai sebelum sempat dipasangi pendengar
          if (img.complete && img.naturalWidth) pas();
          else img.addEventListener('load', pas, { once: true });
        }
      }

      let putaran: number[] = [];
      function jalankanGaleri() {
        putaran.forEach(clearInterval);
        putaran = [];
        const diam = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        for (const kotak of document.querySelectorAll<HTMLElement>('[data-galeri]')) {
          const gambar = [...kotak.querySelectorAll('img')];
          const tombol = [...kotak.querySelectorAll<HTMLButtonElement>('.titik button')];
          let ke = 0;
          const siap = (g: HTMLImageElement) => g.complete && g.naturalWidth > 0;
          // sudah selesai tapi tidak menghasilkan piksel apa pun = gagal
          const rusak = (g: HTMLImageElement) => g.complete && g.naturalWidth === 0;

          /*
           * Gambar yang gagal dimuat dikeluarkan dari putaran, titiknya
           * disembunyikan, dan kalau yang sedang tampil itu yang gagal,
           * digantikan gambar pertama yang masih baik.
           *
           * Ini terjadi sungguhan di jendela antara commit dan deploy: berkas
           * gambarnya sudah tercatat di daftar tapi belum ada di situs yang
           * tayang, sekitar dua menit lamanya. Tanpa ini yang terlihat bingkai
           * kosong yang tidak pernah berganti.
           */
          const buang = (i: number) => {
            gambar[i].classList.add('rusak');
            if (tombol[i]) tombol[i].closest('li')!.hidden = true;
            if (i === ke) {
              const baik = gambar.findIndex((g) => !rusak(g));
              if (baik >= 0) tampilkan(baik);
            }
          };
          gambar.forEach((g, i) => {
            if (rusak(g)) buang(i);
            else g.addEventListener('error', () => buang(i), { once: true });
          });
          const tampilkan = (n: number) => {
            ke = (n + gambar.length) % gambar.length;
            gambar.forEach((g, i) => g.classList.toggle('tampil', i === ke));
            tombol.forEach((b, i) => b.setAttribute('aria-current', String(i === ke)));
          };
          let jam = 0;
          // Kalau gerakannya diminta dikurangi, hitungan mundurnya tidak
          // pernah dipasang — tapi titik-titiknya tetap bisa ditekan.
          const lanjut = () => {
            clearInterval(jam);
            if (diam) return;
            jam = window.setInterval(() => {
              /*
               * Jangan pernah berpindah ke gambar yang belum termuat.
               *
               * Hitungan mundurnya jalan sejak panel dibuka, tidak peduli
               * jaringannya secepat apa. Terukur pada 400 kbps: pada detik ke-2
               * galerinya sudah berganti ke gambar kedua padahal belum satu pun
               * gambar selesai diunduh — yang terlihat bingkai kosong dengan
               * tulisan alt. Melewatkan giliran jauh lebih baik: gambar yang
               * sekarang tetap terlihat sampai penggantinya benar-benar siap.
               */
              // lompati yang rusak; yang belum termuat cukup ditunggu giliran
              // berikutnya
              let berikut = (ke + 1) % gambar.length;
              for (let n = 0; n < gambar.length && rusak(gambar[berikut]); n++) {
                berikut = (berikut + 1) % gambar.length;
              }
              if (berikut !== ke && siap(gambar[berikut])) tampilkan(berikut);
            }, 3600);
            putaran = putaran.concat(jam);
          };

          tombol.forEach((b, i) =>
            b.addEventListener('click', () => {
              tampilkan(i);
              lanjut(); // pilihan orang menang atas hitungan mundur yang sedang jalan
            })
          );
          // berhenti selama ditunjuk atau disentuh: yang sedang melihat satu
          // gambar tidak sedang menunggu gambar berikutnya
          kotak.addEventListener('pointerenter', () => clearInterval(jam));
          kotak.addEventListener('pointerleave', lanjut);
          // Hitungan mundurnya baru dimulai setelah sampulnya sendiri terlihat.
          // Tanpa ini, di jaringan lambat gilirannya habis sebelum ada yang
          // sempat dilihat sama sekali.
          if (siap(gambar[0])) lanjut();
          else gambar[0].addEventListener('load', lanjut, { once: true });
        }
      }

      function openPanel(slug: string) {
        content ??= game.cache.json.get('content');
        if (!content) return;

        const page = content.pages.find((p) => p.panel === slug);

        // Projek dipakai selebar panel; halaman biasa tetap selebar paragraf
        panelBody.className = slug === 'projects' ? 'prose lebar' : 'prose';

        if (slug === 'projects') {
          panelTitle.textContent = 'Projects';
          panelBody.innerHTML = `<div class="projects">${content.projects
            .map((p) => {
              const tombol = [
                p.demo ? tautanLuar(p.demo, 'DEMO') : '',
                p.repo ? tautanLuar(p.repo, 'KODE') : '',
              ].join('');
              return `<article class="card">
                ${bingkaiGambar(p)}
                <div class="isi">
                  <h3 class="judul">${p.title}${p.year ? `<span class="tahun">${p.year}</span>` : ''}</h3>
                  <p class="ringkas">${p.summary ?? ''}</p>
                  ${p.stack?.length ? `<ul class="chips">${p.stack.map((t) => `<li>${t}</li>`).join('')}</ul>` : ''}
                  ${tombol ? `<div class="aksi">${tombol}</div>` : ''}
                  ${p.html?.trim() ? `<details class="rinci"><summary>Rincian</summary>${p.html}</details>` : ''}
                </div>
              </article>`;
            })
            .join('')}</div>`;
        } else if (page) {
          panelTitle.textContent = page.title;

          // kartu profil: foto, nama, peran, plus pintasan LinkedIn
          const profil = page.name
            ? `<aside class="profil">
                 ${page.photo ? `<img src="${page.photo}" alt="Foto ${page.name}" width="84" height="84" />` : ''}
                 <div><b>${page.name}</b><span>${page.role ?? ''}</span></div>
                 ${page.linkedin ? `<a class="lencana" href="${page.linkedin}" target="_blank" rel="noopener" aria-label="LinkedIn">${IKON.linkedin}</a>` : ''}
               </aside>`
            : '';

          // kartu kontak berikon menggantikan daftar Markdown
          const tautan = page.links?.length
            ? `<ul class="kontak">${page.links
                .map(
                  (l) => `<li><a href="${l.url}" target="_blank" rel="noopener">
                    <span class="ik">${IKON[l.icon] ?? ''}</span>
                    <span class="tk"><b>${l.label}</b><em>${l.value}</em></span>
                  </a></li>`
                )
                .join('')}</ul>`
            : '';

          // daftar berkelompok (tech stack) jadi chip, bukan baris panjang
          // yang dipisah titik tengah: pemenggalan barisnya selalu meleset
          const grup = page.groups?.length
            ? page.groups
                .map(
                  (g) => `<section class="grup"><h3>${g.title}</h3>
                    <ul class="chips">${g.items.map((i) => `<li>${i}</li>`).join('')}</ul>
                  </section>`
                )
                .join('')
            : '';

          panelBody.innerHTML =
            profil +
            (page.intro ? `<p class="intro">${page.intro}</p>` : '') +
            tautan +
            (page.html ?? '') +
            grup +
            (page.outro ? `<p class="outro">${page.outro}</p>` : '');
        } else {
          return;
        }
        bentukBingkai();
        jalankanGaleri();
        const sheet = panel.querySelector('.sheet') as HTMLElement;
        sheet.scrollTop = 0;
        sheet.classList.remove('tergulung');
        sheet.onscroll = () => sheet.classList.toggle('tergulung', sheet.scrollTop > 4);
        panel.hidden = false;
      }

      const closePanel = () => {
        // timer galeri ikut berhenti: tidak ada yang perlu berganti gambar di
        // panel yang sudah tidak terlihat
        putaran.forEach(clearInterval);
        putaran = [];
        panel.hidden = true;
      };
      $('[data-close-panel]').addEventListener('click', closePanel);
      panel.addEventListener('click', (e) => {
        if (e.target === panel) closePanel();
      });

      /* ---- game → DOM ---- */
      game.events.on('mapporto:panel', (slug: string) => openPanel(slug));
      // Berdiri dekat sebuah rumah membuka panelnya; alamatnya ikut berpindah
      // supaya tetap menyebut tempat karakter berada — sama seperti kalau
      // tempatnya dipilih lewat menu.
      game.events.on('mapporto:alamat', (id: string) => {
        const alamat = alamatPoi(id);
        if (location.pathname !== alamat) history.pushState(null, '', alamat);
      });
      // menu baru muncul setelah dunia tampil — layar loading & judul dibiarkan bersih
      game.events.once('mapporto:world', () => document.body.classList.add('in-game'));

      /* ---- DOM → game ---- */
      // Tombolnya <a href> sungguhan: bisa dibuka di tab baru, terbaca mesin
      // pencari, dan tetap jalan kalau skrip ini gagal dimuat. Klik biasa
      // ditahan supaya perpindahannya jadi animasi petir, bukan muat ulang.
      document.querySelectorAll<HTMLAnchorElement>('[data-travel]').forEach((a) =>
        a.addEventListener('click', (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
          e.preventDefault();
          goTo(a.dataset.travel!);
        })
      );

      /* ---- peta besar ---- */
      const mapwrap = $('#mapwrap');
      let markersBuilt = false;

      type Poi = { id: string; label: string; at: [number, number] };

      function buildMarkers() {
        const w = game.scene.getScene('World') as unknown as
          | {
            poiList: Poi[];
            mapPixelSize: { w: number; h: number };
            travelTo: (id: string) => void;
            gantunganPoi: (p: Poi) => { x: number; y: number };
          }
          | null;
        if (!w?.poiList?.length) return;
        const size = w.mapPixelSize;

        for (const poi of w.poiList) {
          const btn = document.createElement('button');
          btn.className = 'poimark';
          btn.type = 'button';
          // titik gantung yang sama dengan gelembung di dunia: puncak bangunan
          const g = w.gantunganPoi(poi);
          btn.style.left = `${(g.x / size.w) * 100}%`;
          btn.style.top = `${(g.y / size.h) * 100}%`;
          btn.innerHTML = `<span class="tag">${poi.label}</span>`;
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            goTo(poi.id);
          });
          mapwrap.appendChild(btn);
        }

        /*
         * Klik di dekat sebuah tempat tetap diterima, supaya tidak harus
         * mengenai gelembungnya dengan presisi — tapi hanya sampai jarak
         * tertentu.
         *
         * Dulu tanpa batas: klik di padang kosong pun memilih tempat
         * "terdekat", yang bisa berada di seberang peta. Menekan satu titik
         * lalu mendarat di tempat yang sama sekali lain terasa seperti
         * salah pencet, padahal itu memang yang diprogramkan.
         */
        const JANGKAUAN = 40; // piksel dunia, kira-kira dua setengah tile
        mapwrap.addEventListener('click', (e) => {
          const r = $('#mapimg').getBoundingClientRect();
          const wx = ((e.clientX - r.left) / r.width) * size.w;
          const wy = ((e.clientY - r.top) / r.height) * size.h;
          let best: Poi | null = null;
          let bestD = JANGKAUAN;
          for (const poi of w.poiList) {
            const d = Math.hypot(poi.at[0] * 16 + 8 - wx, poi.at[1] * 16 + 8 - wy);
            if (d < bestD) { bestD = d; best = poi; }
          }
          if (best) goTo(best.id);
        });

        markersBuilt = true;
      }

      function goTo(id: string) {
        closePanel();
        mapModal.hidden = true;
        $('#menusheet').hidden = true;
        $('#setelan').hidden = true;
        travel(game, id);
        const alamat = alamatPoi(id);
        if (location.pathname !== alamat) history.pushState(null, '', alamat);
      }

      const menuSheet = $('#menusheet');
      const closeMenu = () => (menuSheet.hidden = true);
      $('[data-open-menu]').addEventListener('click', () => (menuSheet.hidden = false));
      $('[data-close-menu]').addEventListener('click', closeMenu);
      menuSheet.addEventListener('click', (e) => {
        if (e.target === menuSheet) closeMenu();
      });

      document.querySelectorAll<HTMLButtonElement>('[data-open-map]').forEach((btn) =>
        btn.addEventListener('click', () => {
          closeMenu();
          if (!markersBuilt) buildMarkers();
          mapModal.hidden = false;
        })
      );
      $('[data-close-map]').addEventListener('click', () => (mapModal.hidden = true));
      mapModal.addEventListener('click', (e) => {
        if (e.target === mapModal) mapModal.hidden = true;
      });

      /* ---- suara ---- */
      /*
       * Satu penangkap untuk semua tombol, bukan satu per tombol.
       *
       * Tombolnya tersebar di lima tempat — bilah atas, daftar menu, penanda
       * peta besar, tombol tutup, tautan DEMO/KODE di kartu projek — dan
       * sebagian baru dibuat setelah halaman jalan. Mendaftarkan satu per satu
       * berarti setiap tombol baru nanti lahir tanpa bunyi, dan tidak ada yang
       * akan menyadarinya sampai ada yang mengeluh.
       *
       * `pointerdown`, bukan `click`: bunyinya jatuh saat tombol ditekan, di
       * saat yang sama dengan tombol yang turun 3px. Menunggu `click` membuat
       * bunyinya terasa terlambat sepersekian detik.
       */
      document.addEventListener('pointerdown', (e) => {
        if ((e.target as HTMLElement).closest?.('.pixbtn, .poimark')) efek('klik');
      });

      const soundBtns = document.querySelectorAll<HTMLButtonElement>('[data-toggle-sound]');
      const geser = $<HTMLInputElement>('#volume');
      const nilai = $('#volume-nilai');
      const syncSound = () => {
        const hidup = !sedangBisu();
        soundBtns.forEach((b) => b.classList.toggle('on', hidup));
        // Angka yang ditampilkan mengikuti apa yang TERDENGAR: dibisukan berarti
        // nol, walaupun gesernya masih ingat posisi terakhir.
        const persen = Math.round((hidup ? volumeSekarang() : 0) * 100);
        geser.value = String(persen);
        nilai.textContent = `${persen}%`;
      };
      soundBtns.forEach((b) =>
        b.addEventListener('click', () => {
          setelBisu(!sedangBisu());
          syncSound();
        })
      );
      geser.addEventListener('input', () => {
        setelVolume(Number(geser.value) / 100);
        // digeser sampai nol = dibisukan; tidak ada gunanya dua cara mematikan
        // yang saling bertentangan
        if (Number(geser.value) === 0 && !sedangBisu()) setelBisu(true);
        syncSound();
      });
      syncSound();

      /* ---- panel setelan ---- */
      const setelan = $('#setelan');
      const tutupSetelan = () => (setelan.hidden = true);
      document.querySelectorAll<HTMLButtonElement>('[data-open-setelan]').forEach((b) =>
        b.addEventListener('click', () => {
          closeMenu();
          syncSound();
          syncFast();
          setelan.hidden = false;
        })
      );
      $('[data-close-setelan]').addEventListener('click', tutupSetelan);
      setelan.addEventListener('click', (e) => {
        if (e.target === setelan) tutupSetelan();
      });

      /* ---- mode animasi cepat ---- */
      const fastBtns = document.querySelectorAll<HTMLButtonElement>('[data-toggle-fast]');
      const syncFast = () => {
        const on = localStorage.getItem('mapporto:fastFx') === '1';
        fastBtns.forEach((b) => {
          b.classList.toggle('on', on);
          // Di dalam panel tombolnya berdiri sendiri tanpa tombol pembanding di
          // sebelahnya, jadi warna saja tidak cukup memberi tahu ini menyala
          // atau mati — kata-katanya yang harus mengatakannya.
          b.textContent = on ? 'Animasi cepat: nyala' : 'Animasi cepat: mati';
        });
      };
      fastBtns.forEach((b) =>
        b.addEventListener('click', () => {
          const on = localStorage.getItem('mapporto:fastFx') === '1';
          localStorage.setItem('mapporto:fastFx', on ? '0' : '1');
          syncFast();
        })
      );
      try {
        syncFast();
      } catch {
        /* localStorage bisa diblokir; bukan alasan gagal */
      }

      /* ---- alamat: /cv, /about, … tanpa tanda pagar ----
       *
       * Alamat menyebut TEMPAT karakter berdiri, bukan panel yang sedang
       * terbuka. Menutup panel tidak mengubahnya — karakternya memang masih
       * berdiri di situ. Itu juga yang membuat tombol Back terasa benar: satu
       * langkah mundur = satu perpindahan tempat, bukan satu klik tutup.
       */
      function dariAlamat() {
        const poi = poiAlamat(location.pathname);
        if (poi) travel(game, poi);
        else closePanel();
      }
      window.addEventListener('popstate', dariAlamat);
      game.events.once('mapporto:ready', dariAlamat);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closePanel();
          mapModal.hidden = true;
          menuSheet.hidden = true;
          setelan.hidden = true;
        }
      });
    </script>
  </body>
</html>
