---
import '../styles/global.css';
import '../styles/admin.css';
---

<html lang="id" class="adminhtml">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin — Rahmat Portofolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=Pixelify+Sans:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class="adminpage">
    <header class="adminbar">
      <h1>ADMIN</h1>
      <span id="repo-info" class="muted">belum terhubung</span>
      <a class="pixbtn" href="/">← Situs</a>
      <button class="pixbtn" id="logout" hidden>Keluar</button>
    </header>

    <!-- Masuk -->
    <section class="panelbox" id="login">
      <h2>Masuk</h2>
      <p class="muted">
        Perubahan disimpan sebagai commit ke repo, lalu Vercel membangun ulang
        situs otomatis — sekitar satu menit sampai terlihat.
      </p>
      <form id="form-login">
        <label>
          Password
          <input type="password" id="password" autocomplete="current-password" required />
        </label>
        <button class="pixbtn primary" type="submit">Masuk</button>
      </form>
      <p class="err" id="login-err" hidden></p>
    </section>

    <!-- Ruang kerja -->
    <main id="kerja" hidden>
      <nav class="tabs">
        <button class="pixbtn tab on" data-tab="projek">Projects</button>
        <button class="pixbtn tab" data-tab="foto">Foto About</button>
      </nav>

      <!-- Projects -->
      <section class="tabpane" data-pane="projek">
        <div class="dua">
          <div class="panelbox">
            <h2>Daftar projek</h2>
            <ul class="daftar" id="daftar"></ul>
            <button class="pixbtn" id="baru">+ Projek baru</button>
          </div>

          <form class="panelbox" id="form">
            <h2 id="form-judul">Projek baru</h2>
            <input type="hidden" id="slug" />

            <label>
              <span class="baris">Judul <span class="wajib">*</span></span>
              <input type="text" id="f-title" required maxlength="80" placeholder="Nama projeknya" />
            </label>
            <label>
              <span class="baris">Ringkasan <span class="wajib">*</span></span>
              <textarea id="f-summary" rows="2" required maxlength="200" placeholder="Satu kalimat singkat"></textarea>
              <span class="muted small">Ini yang tampil di kartu.</span>
            </label>
            <label>
              <span class="baris">Teknologi</span>
              <input type="text" id="f-stack" placeholder="Next.js, TypeScript, Solidity" />
              <span class="muted small">Pisahkan dengan koma.</span>
            </label>

            <span class="baris">Gambar projek</span>
            <div class="galeriadmin" id="galeri-projek"></div>
            <div>
              <input type="file" id="berkas-projek" class="berkastersembunyi" multiple
                     accept="image/jpeg,image/png,image/webp,image/*" />
              <label class="pixbtn" for="berkas-projek">Tambah gambar…</label>
              <p class="muted small" id="namagambar">Belum ada gambar dipilih.</p>
              <span class="muted small">Boleh sampai 6 gambar — kartunya menampilkan satu per satu
                bergantian, dan yang pertama jadi sampul. Bentuknya dibiarkan apa adanya: tangkapan
                layar ponsel tetap tegak, dan bingkai kartunya yang menyesuaikan. Sisi terpanjangnya
                dikecilkan ke 1200px di browser, lalu ikut tersimpan saat kamu menekan Simpan.</span>
            </div>
            <div class="row gap">
              <label><span class="baris">Tahun</span>
                <input id="f-year" type="number" min="2015" max="2100" /></label>
              <label><span class="baris">Urutan</span>
                <input id="f-order" type="number" min="1" max="99" value="10" /></label>
            </div>
            <label><span class="baris">Link repo</span>
              <input id="f-repo" type="url" placeholder="https://github.com/..." /></label>
            <label><span class="baris">Link demo</span>
              <input id="f-demo" type="url" placeholder="https://..." /></label>
            <label><span class="baris">Isi (Markdown)</span>
              <textarea id="f-body" rows="9" placeholder="Ceritakan projeknya. **tebal**, - daftar, [tautan](https://...)"></textarea>
            </label>

            <div class="row gap">
              <button class="pixbtn primary" type="submit">Simpan</button>
              <button class="pixbtn danger" type="button" id="hapus" hidden>Hapus</button>
            </div>
            <p class="err" id="form-err" hidden></p>
            <p class="ok" id="form-ok" hidden></p>
          </form>
        </div>
      </section>

      <!-- Foto -->
      <section class="tabpane" data-pane="foto" hidden>
        <div class="panelbox">
          <h2>Foto halaman About</h2>
          <p class="muted">
            Dipotong jadi persegi dan dikecilkan ke 512&times;512 di browser
            sebelum diunggah, jadi ukurannya tetap kecil.
          </p>
          <div class="fotorow">
            <img id="pratinjau" src="/img/profile.jpg" alt="Foto sekarang" />
            <div>
              <input type="file" id="berkas" class="berkastersembunyi"
                     accept="image/jpeg,image/png,image/webp,image/gif,image/*" />
              <label class="pixbtn" for="berkas">Pilih gambar…</label>
              <p class="muted small" id="namafoto">Belum ada gambar dipilih.</p>
              <button class="pixbtn primary" id="unggah">Unggah</button>
            </div>
          </div>
          <p class="err" id="foto-err" hidden></p>
          <p class="ok" id="foto-ok" hidden></p>
        </div>
      </section>
    </main>

    <script>
      const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
      const FOLDER_PESAN = 'Vercel membangun ulang situs, sekitar satu menit.';

      const pesan = (el: string, teks: string, jenis: 'err' | 'ok' = 'err') => {
        const e = $(el);
        e.textContent = teks;
        e.hidden = !teks;
        if (teks && jenis === 'ok') setTimeout(() => (e.hidden = true), 7000);
      };

      /** Semua panggilan API lewat sini supaya sesi kedaluwarsa tertangani sekali saja. */
      async function api(path: string, init: RequestInit = {}) {
        const res = await fetch(path, {
          ...init,
          headers: { 'Content-Type': 'application/json', ...init.headers },
        });
        const data = await res.json().catch(() => ({}));
        if (res.status === 401) {
          tampilkanMasuk();
          throw new Error(data.error ?? 'Sesi berakhir.');
        }
        if (!res.ok) throw new Error(data.error ?? `Gagal (${res.status}).`);
        return data;
      }

      function tampilkanKerja() {
        $('#login').hidden = true;
        $('#kerja').hidden = false;
        $('#logout').hidden = false;
        $('#repo-info').textContent = 'terhubung';
      }
      function tampilkanMasuk() {
        $('#login').hidden = false;
        $('#kerja').hidden = true;
        $('#logout').hidden = true;
        $('#repo-info').textContent = 'belum masuk';
      }

      /* ---------------- masuk ---------------- */

      $('#form-login').addEventListener('submit', async (e) => {
        e.preventDefault();
        try {
          pesan('#login-err', '');
          await api('/api/login', {
            method: 'POST',
            body: JSON.stringify({ password: ($('#password') as HTMLInputElement).value }),
          });
          ($('#password') as HTMLInputElement).value = '';
          tampilkanKerja();
          await muatDaftar();
        } catch (err) {
          pesan('#login-err', (err as Error).message);
        }
      });

      $('#logout').addEventListener('click', async () => {
        await fetch('/api/logout', { method: 'POST' });
        tampilkanMasuk();
      });

      /* ---------------- daftar projek ---------------- */

      async function muatDaftar() {
        const { items } = await api('/api/projects');
        const ul = $('#daftar');
        ul.innerHTML = items.length ? '' : '<li class="muted">Belum ada projek.</li>';
        for (const slug of items as string[]) {
          const li = document.createElement('li');
          const b = document.createElement('button');
          b.className = 'pixbtn wide';
          b.textContent = slug;
          b.addEventListener('click', () => bukaProjek(slug));
          li.appendChild(b);
          ul.appendChild(li);
        }
      }

      /** Frontmatter dibaca seadanya — cukup untuk mengisi ulang formulir. */
      function uraikan(md: string) {
        const m = md.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
        if (!m) return { data: {} as Record<string, string>, body: md };
        const data: Record<string, string> = {};
        for (const baris of m[1].split('\n')) {
          const k = baris.match(/^(\w+):\s*(.*)$/);
          if (!k) continue;
          let v = k[2].trim();
          if (v.startsWith('"') && v.endsWith('"')) {
            try { v = JSON.parse(v); } catch { /* biarkan apa adanya */ }
          }
          data[k[1]] = v;
        }
        return { data, body: m[2] };
      }

      async function bukaProjek(slug: string) {
        try {
          const { md } = await api(`/api/projects?slug=${encodeURIComponent(slug)}`);
          const { data, body } = uraikan(md);
          $('#form-judul').textContent = slug;
          ($('#slug') as HTMLInputElement).value = slug;
          ($('#f-title') as HTMLInputElement).value = data.title ?? '';
          ($('#f-summary') as HTMLTextAreaElement).value = data.summary ?? '';
          ($('#f-stack') as HTMLInputElement).value = (data.stack ?? '')
            .replace(/^\[|\]$/g, '')
            .split(',').map((x) => x.trim().replace(/^"|"$/g, '')).filter(Boolean).join(', ');
          ($('#f-year') as HTMLInputElement).value = data.year ?? '';
          ($('#f-order') as HTMLInputElement).value = data.order ?? '10';
          ($('#f-repo') as HTMLInputElement).value = data.repo ?? '';
          ($('#f-demo') as HTMLInputElement).value = data.demo ?? '';
          ($('#f-body') as HTMLTextAreaElement).value = body.trim();
          // `images: [...]` bentuk sekarang; `image: "..."` bentuk lama yang
          // masih dipakai projek yang belum pernah disimpan ulang
          const daftarGambar = (data.images ?? '')
            .replace(/^\[|\]$/g, '')
            .split(',').map((x) => x.trim().replace(/^"|"$/g, '')).filter(Boolean);
          galeri = daftarGambar.length
            ? daftarGambar.map((url) => ({ url }))
            : data.image ? [{ url: data.image }] : [];
          gambarkanGaleri();
          $('#hapus').hidden = false;
          pesan('#form-err', ''); pesan('#form-ok', '');
        } catch (err) {
          pesan('#form-err', (err as Error).message);
        }
      }

      $('#baru').addEventListener('click', () => {
        ($('#form') as HTMLFormElement).reset();
        ($('#slug') as HTMLInputElement).value = '';
        ($('#f-order') as HTMLInputElement).value = '10';
        galeri = [];
        gambarkanGaleri();
        $('#form-judul').textContent = 'Projek baru';
        $('#hapus').hidden = true;
        pesan('#form-err', ''); pesan('#form-ok', '');
      });

      $('#form').addEventListener('submit', async (e) => {
        e.preventDefault();
        try {
          pesan('#form-err', '');
          // Gambar diunggah lebih dulu supaya slug-nya sudah pasti sebelum
          // dirujuk dari frontmatter.
          const slugAwal =
            ($('#slug') as HTMLInputElement).value ||
            ($('#f-title') as HTMLInputElement).value
              .toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
              .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60);

          /*
           * Yang baru dipilih diunggah dulu, satu per satu, memakai nomor
           * urutnya sebagai nama berkas. Yang sudah punya url dibiarkan —
           * mengunggah ulang berkas yang isinya tidak berubah cuma menambah
           * commit.
           *
           * Urutannya juga yang memperbaiki cacat lama: dulu url hasil unggahan
           * tidak pernah disimpan kembali ke keadaan formulir, jadi menyimpan
           * projek untuk KEDUA kalinya mengirim `image` kosong dan barisnya
           * hilang dari frontmatter. Gambarnya masih ada di repo, tapi kartunya
           * berubah jadi papan bergaris. Itu yang terjadi pada MonadWishes.
           */
          for (let i = 0; i < galeri.length; i++) {
            const g = galeri[i];
            if (!g.base64) continue;
            const r = await api('/api/photo', {
              method: 'POST',
              body: JSON.stringify({ base64: g.base64, slug: slugAwal, urutan: i + 1 }),
            });
            galeri[i] = { url: r.url };
          }
          gambarkanGaleri();

          const { slug } = await api('/api/projects', {
            method: 'PUT',
            body: JSON.stringify({
              images: galeri.map((g) => g.url).filter(Boolean),
              slug: ($('#slug') as HTMLInputElement).value,
              title: ($('#f-title') as HTMLInputElement).value,
              summary: ($('#f-summary') as HTMLTextAreaElement).value,
              stack: ($('#f-stack') as HTMLInputElement).value.split(',').map((x) => x.trim()).filter(Boolean),
              year: ($('#f-year') as HTMLInputElement).value,
              repo: ($('#f-repo') as HTMLInputElement).value,
              demo: ($('#f-demo') as HTMLInputElement).value,
              order: ($('#f-order') as HTMLInputElement).value,
              body: ($('#f-body') as HTMLTextAreaElement).value,
            }),
          });
          ($('#slug') as HTMLInputElement).value = slug;
          $('#form-judul').textContent = slug;
          $('#hapus').hidden = false;
          pesan('#form-ok', `Tersimpan. ${FOLDER_PESAN}`, 'ok');
          await muatDaftar();
        } catch (err) {
          pesan('#form-err', (err as Error).message);
        }
      });

      $('#hapus').addEventListener('click', async () => {
        const slug = ($('#slug') as HTMLInputElement).value;
        if (!slug || !confirm(`Hapus projek "${slug}"?`)) return;
        try {
          await api(`/api/projects?slug=${encodeURIComponent(slug)}`, { method: 'DELETE' });
          ($('#form') as HTMLFormElement).reset();
          ($('#slug') as HTMLInputElement).value = '';
          $('#form-judul').textContent = 'Projek baru';
          $('#hapus').hidden = true;
          pesan('#form-ok', `Terhapus. ${FOLDER_PESAN}`, 'ok');
          await muatDaftar();
        } catch (err) {
          pesan('#form-err', (err as Error).message);
        }
      });

      /* ---------------- foto ---------------- */

      /**
       * Kecilkan tanpa memotong sedikit pun — dipakai gambar projek.
       *
       * Sebelum ini semua gambar projek dipotong ke 3:2. Untuk tangkapan layar
       * desktop itu nyaris tidak terasa, tapi tangkapan layar ponsel (sekitar
       * 9:19,5) kehilangan dua pertiga tingginya: yang tersisa cuma pita di
       * tengah, tanpa bilah status di atas maupun tombol di bawah.
       *
       * Bentuk gambar itu sendiri informasi — projek ponsel memang tegak.
       * Yang menyesuaikan seharusnya bingkai kartunya, bukan gambarnya yang
       * dipotong supaya muat ke bingkai.
       */
      async function siapkanUtuh(f: File, maksSisi = 1200) {
        const { w, h, gambar } = await muatGambar(f);
        // hanya diperkecil, tidak pernah diperbesar
        const k = Math.min(1, maksSisi / Math.max(w, h));
        const c = document.createElement('canvas');
        c.width = Math.round(w * k);
        c.height = Math.round(h * k);
        c.getContext('2d')!.drawImage(gambar as CanvasImageSource, 0, 0, c.width, c.height);
        return c.toDataURL('image/jpeg', 0.86);
      }

      /** Potong ke rasio tertentu lalu kecilkan — dipakai foto About, yang
          memang harus persegi. */
      async function siapkanGambar(f: File, lebar: number, tinggi: number) {
        const { w, h, gambar } = await muatGambar(f);
        const rasio = lebar / tinggi;
        let sw = w, sh = h;
        if (w / h > rasio) sw = h * rasio; else sh = w / rasio;
        const c = document.createElement('canvas');
        c.width = lebar; c.height = tinggi;
        c.getContext('2d')!.drawImage(gambar as CanvasImageSource,
          (w - sw) / 2, (h - sh) / 2, sw, sh, 0, 0, lebar, tinggi);
        return c.toDataURL('image/jpeg', 0.86);
      }

      /* ---------------- gambar projek ---------------- */

      /**
       * Isi galeri sebuah projek. `url` = sudah ada di repo; `base64` = baru
       * dipilih dan belum diunggah. Sebuah entri selalu punya salah satunya.
       */
      let galeri: { url?: string; base64?: string; pratinjau?: string }[] = [];
      const MAKS_GAMBAR = 6;

      function gambarkanGaleri() {
        const kotak = $('#galeri-projek');
        kotak.innerHTML = galeri
          .map(
            (g, i) =>
              `<figure><img src="${g.pratinjau ?? g.url}" alt="Gambar ${i + 1}" />` +
              `<figcaption>${i + 1}</figcaption>` +
              `<button type="button" class="buang" data-buang="${i}" aria-label="Buang gambar ${i + 1}">✕</button></figure>`
          )
          .join('');
        kotak.querySelectorAll<HTMLButtonElement>('[data-buang]').forEach((b) =>
          b.addEventListener('click', () => {
            galeri.splice(Number(b.dataset.buang), 1);
            gambarkanGaleri();
          })
        );
        $('#namagambar').textContent = galeri.length
          ? `${galeri.length} gambar. Yang pertama jadi sampul.`
          : 'Belum ada gambar dipilih.';
      }
      $('#berkas-projek').addEventListener('change', async (e) => {
        const masukan = e.target as HTMLInputElement;
        const berkas = [...(masukan.files ?? [])];
        if (!berkas.length) return;
        pesan('#form-err', '');

        // Menambah, bukan mengganti: memilih berkas dua kali berturut-turut
        // adalah cara paling wajar mengumpulkan gambar dari folder berbeda.
        for (const f of berkas) {
          if (galeri.length >= MAKS_GAMBAR) {
            pesan('#form-err', `Maksimal ${MAKS_GAMBAR} gambar per projek.`);
            break;
          }
          try {
            const url = await siapkanUtuh(f);
            galeri.push({ base64: url.split(',')[1], pratinjau: url });
          } catch {
            const jenis = f.type || f.name.split('.').pop() || 'tidak dikenal';
            pesan('#form-err', `"${f.name}" bertipe "${jenis}" tidak bisa dibaca browser ini. Simpan ulang sebagai JPG dulu.`);
          }
        }
        gambarkanGaleri();
        // dikosongkan supaya memilih berkas yang sama lagi tetap memicu change
        masukan.value = '';
      });

      let fotoBase64 = '';

      /**
       * Dua jalur pembacaan gambar. `createImageBitmap` cepat tapi menolak
       * beberapa format; elemen <img> memakai dekoder bawaan browser yang
       * cakupannya lebih luas. HEIC dari iPhone gagal di keduanya — itu
       * dilaporkan dengan pesan yang menyebut jenis berkasnya.
       */
      async function muatGambar(f: File) {
        try {
          const bit = await createImageBitmap(f);
          return { w: bit.width, h: bit.height, gambar: bit };
        } catch {
          const url = URL.createObjectURL(f);
          try {
            const im = new Image();
            im.src = url;
            await im.decode();
            return { w: im.naturalWidth, h: im.naturalHeight, gambar: im };
          } finally {
            setTimeout(() => URL.revokeObjectURL(url), 10_000);
          }
        }
      }
      $('#berkas').addEventListener('change', async (e) => {
        const f = (e.target as HTMLInputElement).files?.[0];
        if (!f) return;
        pesan('#foto-err', '');
        $('#namafoto').textContent = `Dipilih: ${f.name}`;
        fotoBase64 = '';
        try {
          // Dikecilkan di browser: berkas dari kamera bisa beberapa MB, dan
          // itu ikut masuk ke repo selamanya.
          const url = await siapkanGambar(f, 512, 512);
          ($('#pratinjau') as HTMLImageElement).src = url;
          fotoBase64 = url.split(',')[1];
        } catch (err) {
          fotoBase64 = '';
          $('#namafoto').textContent = 'Gambar gagal dibaca.';
          const jenis = f.type || f.name.split('.').pop() || 'tidak dikenal';
          pesan(
            '#foto-err',
            `Gambar bertipe "${jenis}" tidak bisa dibaca browser ini. ` +
              `Foto HEIC dari iPhone termasuk — simpan ulang sebagai JPG atau PNG dulu. (${(err as Error).message})`
          );
        }
      });

      $('#unggah').addEventListener('click', async () => {
        // Dulu tombolnya di-disable saat belum ada gambar. Tombol mati tidak
        // memberi respons apa pun saat ditekan — terbaca seperti fitur rusak,
        // bukan seperti langkah yang belum dilakukan. Sekarang dia menjawab.
        if (!fotoBase64) {
          pesan('#foto-err', 'Pilih gambarnya dulu lewat tombol "Pilih gambar…" di atas.');
          return;
        }
        try {
          pesan('#foto-err', '');
          await api('/api/photo', { method: 'POST', body: JSON.stringify({ base64: fotoBase64 }) });
          pesan('#foto-ok', `Terunggah. ${FOLDER_PESAN}`, 'ok');
        } catch (err) {
          pesan('#foto-err', (err as Error).message);
        }
      });

      /* ---------------- tab ---------------- */

      document.querySelectorAll<HTMLButtonElement>('.tab').forEach((t) =>
        t.addEventListener('click', () => {
          document.querySelectorAll('.tab').forEach((x) => x.classList.remove('on'));
          t.classList.add('on');
          document.querySelectorAll<HTMLElement>('.tabpane').forEach((p) => {
            p.hidden = p.dataset.pane !== t.dataset.tab;
          });
        })
      );

      /* ---------------- cek sesi yang masih hidup ---------------- */

      fetch('/api/projects')
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => { if (d) { tampilkanKerja(); muatDaftar(); } })
        .catch(() => { /* belum masuk — biarkan formulir masuk tampil */ });
    </script>
  </body>
</html>
